HOST=0.0.0.0
PORT=3210
ACCESS_TOKEN=change-me
AUTH_SESSION_TTL_HOURS=24
AUTH_RATE_LIMIT_WINDOW_MINUTES=10
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_BLOCK_MINUTES=15
TAILSCALE_ONLY=false
TRUSTED_CIDRS=
WS_HEARTBEAT_SECONDS=30
DEFAULT_CWD=
SHELL_BIN=
SHELL_ARGS=
# Windows compatibility override:
POWERSHELL_BIN=
CODEX_BIN=codex
CODEX_MODEL=
CODEX_PROFILE=
CODEX_FULL_ACCESS=true
CODEX_NO_ALT_SCREEN=true
CODEX_EXTRA_ARGS=
# IANA timezone name, e.g. UTC, Asia/Shanghai, America/Los_Angeles
DISPLAY_TIMEZONE=UTC

# File and local web previews. Keep gateways on loopback when using frp/Caddy.
PREVIEW_ENABLED=true
PREVIEW_HOST=127.0.0.1
PREVIEW_PORT=3211
PREVIEW_SERVICE_PORTS=3212,3213,3214,3215
# Public FILE preview origin; service slots use the corresponding port offsets.
# Example: https://chat.example.com:8444 -> service slots 8445-8448.
PREVIEW_PUBLIC_ORIGIN=
# Internal kkFileView 5.0.3 upstream; do not publish this port directly.
KKFILEVIEW_URL=http://127.0.0.1:8012
# Runtime setup and supported formats: docs/operations/local-preview.md
